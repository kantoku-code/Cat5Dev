Option Explicit
Dim gOperationId, gStepId, gKind, gTargetProject, gEncoding, gDirectory
Dim gFSO, gApc, gProjects, gProject, gComponents
Dim gFailures, gItems, gProjectNames, gExpected, gSucceeded, gUpdated, gDeleted

Sub CATMain()
    On Error Resume Next
    Dim errN, errText
    gOperationId = "{{OPERATION_ID}}"
    gStepId = "{{STEP_ID}}"
    gKind = "push"
    gTargetProject = "{{TARGET_PROJECT}}"
    gEncoding = "{{ENCODING}}"
    gDirectory = "{{TEMP_DIR}}"
    gFailures = ""
    gItems = ""
    gProjectNames = ""
    gExpected = 1
    gSucceeded = 0
    gUpdated = 0
    gDeleted = 0
    Set gFSO = Nothing
    Set gApc = Nothing
    Set gProjects = Nothing
    Set gProject = Nothing
    Set gComponents = Nothing

    Err.Clear
    Set gFSO = CreateObject("Scripting.FileSystemObject")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "init.filesystem", gTargetProject, errN, errText
        FinishResult
        Exit Sub
    End If
    If Not ConnectProjects() Then
        FinishResult
        Exit Sub
    End If
    If gKind <> "list" Then
        Set gProject = FindProject()
        If gProject Is Nothing Then
            FinishResult
            Exit Sub
        End If

    Err.Clear
    Set gComponents = gProject.VBComponents
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "project.components", gTargetProject, errN, errText
        FinishResult
        Exit Sub
    End If
    End If
    ApplyModule "{{MODULE_NAME}}", 1, "module.txt"
    FinishResult
End Sub

Function ConnectProjects()
    On Error Resume Next
    Dim errN, errText
    ConnectProjects = False
    Err.Clear
    Set gApc = CreateObject("MSAPC.Apc.7.1")
    If Err.Number <> 0 Then
        Set gApc = Nothing
        Err.Clear
    End If
    If gApc Is Nothing Then
        Err.Clear
        Set gApc = CreateObject("MSAPC.Apc.6.2")
        If Err.Number <> 0 Then
            Set gApc = Nothing
            Err.Clear
        End If
    End If
    If gApc Is Nothing Then

    Err.Clear
    Set gApc = CreateObject("MSAPC.Apc")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "connect.apc", gTargetProject, errN, errText
        Exit Function
    End If
    End If
    If gApc Is Nothing Then
        AddFailure "connect.apc", gTargetProject, 429, "No APC object"
        Exit Function
    End If

    Err.Clear
    Set gProjects = gApc.VBE.VBProjects
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "connect.projects", gTargetProject, errN, errText
        Exit Function
    End If
    ConnectProjects = True
End Function

Function FindProject()
    On Error Resume Next
    Dim total, i, candidate, candidateName, errN, errText
    Set FindProject = Nothing

    Err.Clear
    total = gProjects.Count
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "project.count", gTargetProject, errN, errText
        Exit Function
    End If
    For i = 1 To total

    Err.Clear
    Set candidate = gProjects.Item(i)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "project.lookup", gTargetProject, errN, errText
        Exit Function
    End If

    Err.Clear
    candidateName = candidate.Name
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "project.name", gTargetProject, errN, errText
        Exit Function
    End If
        If StrComp(candidateName, gTargetProject, vbBinaryCompare) = 0 Then
            Set FindProject = candidate
            Exit Function
        End If
    Next
    AddFailure "project.lookup", gTargetProject, 5, "Target project not found"
End Function

Sub ListProjects()
    On Error Resume Next
    Dim total, i, candidate, candidateName, errN, errText

    Err.Clear
    total = gProjects.Count
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "list.count", gTargetProject, errN, errText
        Exit Sub
    End If
    gExpected = total
    For i = 1 To total

    Err.Clear
    Set candidate = gProjects.Item(i)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "list.project", CStr(i), errN, errText
        Exit Sub
    End If

    Err.Clear
    candidateName = candidate.Name
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "list.name", CStr(i), errN, errText
        Exit Sub
    End If
        AppendJson gProjectNames, JsonQuote(candidateName)
        gSucceeded = gSucceeded + 1
    Next
End Sub

Sub ExportModules()
    On Error Resume Next
    Dim total, i, component, componentType, errN, errText

    Err.Clear
    total = gComponents.Count
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.count", gTargetProject, errN, errText
        Exit Sub
    End If
    For i = 1 To total

    Err.Clear
    Set component = gComponents.Item(i)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.component", CStr(i), errN, errText
        Exit Sub
    End If

    Err.Clear
    componentType = component.Type
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.type", CStr(i), errN, errText
        Exit Sub
    End If
        If componentType = 1 Or componentType = 2 Or componentType = 3 Then
            gExpected = gExpected + 1
            ExportOne component, componentType, gExpected - 1
        End If
    Next
End Sub

Sub ExportOne(component, componentType, ordinal)
    On Error Resume Next
    Dim componentName, codeModule, lineCount, sourceText, fileName, errN, errText

    Err.Clear
    componentName = component.Name
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.name", CStr(ordinal), errN, errText
        Exit Sub
    End If

    Err.Clear
    Set codeModule = component.CodeModule
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.codemodule", componentName, errN, errText
        Exit Sub
    End If

    Err.Clear
    lineCount = codeModule.CountOfLines
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.linecount", componentName, errN, errText
        Exit Sub
    End If
    sourceText = ""
    If lineCount > 0 Then

    Err.Clear
    sourceText = codeModule.Lines(1, lineCount)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.lines", componentName, errN, errText
        Exit Sub
    End If
    End If
    fileName = "m" & CStr(ordinal) & ".txt"
    If Not WriteModuleFile(fileName, sourceText, componentName) Then Exit Sub
    AppendJson gItems, "{""name"":" & JsonQuote(componentName) & _
        ",""type"":" & CStr(componentType) & ",""file"":" & JsonQuote(fileName) & "}"
    gSucceeded = gSucceeded + 1
End Sub

Function WriteModuleFile(fileName, sourceText, moduleName)
    On Error Resume Next
    Dim stream, filePath, errN, errText
    WriteModuleFile = False

    Err.Clear
    filePath = gFSO.BuildPath(gDirectory, fileName)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.path", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    Set stream = CreateObject("ADODB.Stream")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.stream", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Type = 2
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.streamtype", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Charset = gEncoding
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.encoding", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Open
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.open", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.WriteText sourceText
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.write", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.SaveToFile filePath, 2
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.save", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Close
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "export.close", moduleName, errN, errText
        Exit Function
    End If
    WriteModuleFile = True
End Function

Function ReadModuleFile(fileName, moduleName, ByRef sourceText)
    On Error Resume Next
    Dim stream, filePath, errN, errText
    ReadModuleFile = False
    sourceText = ""

    Err.Clear
    filePath = gFSO.BuildPath(gDirectory, fileName)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.path", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    Set stream = CreateObject("ADODB.Stream")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.stream", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Type = 2
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.streamtype", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Charset = gEncoding
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.encoding", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Open
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.open", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.LoadFromFile filePath
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.load", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    sourceText = stream.ReadText(-1)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.text", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    stream.Close
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.read.close", moduleName, errN, errText
        Exit Function
    End If
    ReadModuleFile = True
End Function

Function FindModule(moduleName, ByRef lookupSucceeded)
    On Error Resume Next
    Dim total, i, candidate, candidateName, errN, errText
    lookupSucceeded = False
    Set FindModule = Nothing

    Err.Clear
    total = gComponents.Count
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.lookup.count", moduleName, errN, errText
        Exit Function
    End If
    For i = 1 To total

    Err.Clear
    Set candidate = gComponents.Item(i)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.lookup.component", moduleName, errN, errText
        Exit Function
    End If

    Err.Clear
    candidateName = candidate.Name
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.lookup.name", moduleName, errN, errText
        Exit Function
    End If
        If StrComp(candidateName, moduleName, vbTextCompare) = 0 Then
            Set FindModule = candidate
            lookupSucceeded = True
            Exit Function
        End If
    Next
    lookupSucceeded = True
End Function

Sub ApplyModule(moduleName, moduleType, fileName)
    On Error Resume Next
    Dim sourceText, component, lookupSucceeded, existingType, codeModule, lineCount, errN, errText
    If Not ReadModuleFile(fileName, moduleName, sourceText) Then Exit Sub
    Set component = FindModule(moduleName, lookupSucceeded)
    If Not lookupSucceeded Then Exit Sub
    If component Is Nothing Then
        If moduleType = 3 Then
            AddFailure "push.add", moduleName, 5, "New UserForms require a designer"
            Exit Sub
        End If

    Err.Clear
    Set component = gComponents.Add(moduleType)
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.add", moduleName, errN, errText
        Exit Sub
    End If

    Err.Clear
    component.Name = moduleName
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.name", moduleName, errN, errText
        Exit Sub
    End If
    Else

    Err.Clear
    existingType = component.Type
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.type", moduleName, errN, errText
        Exit Sub
    End If
        If existingType <> moduleType Then
            AddFailure "push.type", moduleName, 5, "Module type does not match"
            Exit Sub
        End If
    End If

    Err.Clear
    Set codeModule = component.CodeModule
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.codemodule", moduleName, errN, errText
        Exit Sub
    End If

    Err.Clear
    lineCount = codeModule.CountOfLines
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.linecount", moduleName, errN, errText
        Exit Sub
    End If
    If lineCount > 0 Then

    Err.Clear
    codeModule.DeleteLines 1, lineCount
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.deletelines", moduleName, errN, errText
        Exit Sub
    End If
    End If
    If Len(sourceText) > 0 Then

    Err.Clear
    codeModule.AddFromString sourceText
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.addfromstring", moduleName, errN, errText
        Exit Sub
    End If
    End If
    gSucceeded = gSucceeded + 1
    gUpdated = gUpdated + 1
End Sub

Sub DeleteModule(moduleName)
    On Error Resume Next
    Dim component, lookupSucceeded, errN, errText
    Set component = FindModule(moduleName, lookupSucceeded)
    If Not lookupSucceeded Then Exit Sub
    If component Is Nothing Then
        AddFailure "push.delete", moduleName, 5, "Module to delete not found"
        Exit Sub
    End If

    Err.Clear
    gComponents.Remove component
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "push.delete", moduleName, errN, errText
        Exit Sub
    End If
    gSucceeded = gSucceeded + 1
    gDeleted = gDeleted + 1
End Sub


Sub AddFailure(phase, target, errorCode, message)
    AppendJson gFailures, "{""phase"":" & JsonQuote(phase) & _
        ",""target"":" & JsonQuote(target) & ",""code"":" & CStr(errorCode) & _
        ",""message"":" & JsonQuote(message) & "}"
End Sub
Sub AppendJson(ByRef buffer, value)
    If Len(buffer) > 0 Then buffer = buffer & ","
    buffer = buffer & value
End Sub
Function JsonQuote(value)
    Dim text, output, i, character, code
    text = CStr(value)
    output = ""
    For i = 1 To Len(text)
        character = Mid(text, i, 1)
        code = AscW(character)
        If code < 0 Then code = code + 65536
        Select Case code
            Case 34
                output = output & Chr(92) & Chr(34)
            Case 92
                output = output & Chr(92) & Chr(92)
            Case Else
                If code < 32 Or code > 126 Then
                    output = output & Chr(92) & "u" & Right("0000" & Hex(code), 4)
                Else
                    output = output & character
                End If
        End Select
    Next
    JsonQuote = Chr(34) & output & Chr(34)
End Function


Sub FinishResult()
    On Error Resume Next
    Dim result, stream, temporaryPath, finalPath, errN, errText
    If gFSO Is Nothing Then Exit Sub
    result = "{""version"":1"
    result = result & ",""operationId"":" & JsonQuote(gOperationId)
    result = result & ",""stepId"":" & JsonQuote(gStepId)
    result = result & ",""kind"":" & JsonQuote(gKind)
    result = result & ",""targetProject"":" & JsonQuote(gTargetProject)
    result = result & ",""expectedCount"":" & CStr(gExpected)
    result = result & ",""succeededCount"":" & CStr(gSucceeded)
    result = result & ",""failures"":" & "[" & gFailures & "]"
    result = result & ",""items"":" & "[" & gItems & "]"
    result = result & ",""projects"":" & "[" & gProjectNames & "]"
    result = result & ",""updatedCount"":" & CStr(gUpdated)
    result = result & ",""deletedCount"":" & CStr(gDeleted) & "}"

    Err.Clear
    temporaryPath = gFSO.BuildPath(gDirectory, "result.tmp")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.temppath", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    finalPath = gFSO.BuildPath(gDirectory, "result.json")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.path", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    Set stream = CreateObject("ADODB.Stream")
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.stream", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    stream.Type = 2
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.streamtype", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    stream.Charset = "utf-8"
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.encoding", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    stream.Open
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.open", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    stream.WriteText result
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.write", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    stream.SaveToFile temporaryPath, 2
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.save", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    stream.Close
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.close", gTargetProject, errN, errText
        Exit Sub
    End If

    Err.Clear
    gFSO.MoveFile temporaryPath, finalPath
    If Err.Number <> 0 Then
        errN = Err.Number
        errText = Err.Description
        Err.Clear
        AddFailure "result.publish", gTargetProject, errN, errText
        Exit Sub
    End If
End Sub
